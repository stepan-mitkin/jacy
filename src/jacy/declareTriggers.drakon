{
    "keywords": {
        "function": true
    },
    "params": "context\nbody",
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 0,
            "one": "5"
        },
        "3": {
            "type": "action",
            "one": "4",
            "content": "decl = createDeclaration(\n    \"_triggers_\",\n    triggers\n)"
        },
        "4": {
            "type": "action",
            "one": "1",
            "content": "body.unshift(decl)"
        },
        "5": {
            "type": "action",
            "one": "7",
            "content": "triggers = createObjectExpression()"
        },
        "6": {
            "type": "loopend",
            "one": "3",
            "content": ""
        },
        "7": {
            "type": "loopbegin",
            "one": "10",
            "content": "trigger; context.triggers"
        },
        "8": {
            "type": "action",
            "one": "9",
            "content": "prop = createProperty(name, trigger)"
        },
        "9": {
            "type": "action",
            "one": "6",
            "content": "triggers.properties.push(prop)"
        },
        "10": {
            "type": "action",
            "one": "14",
            "content": "name = trigger.name"
        },
        "11": {
            "type": "action",
            "one": "12",
            "content": "trigger = createObjectExpression()"
        },
        "12": {
            "type": "action",
            "one": "13",
            "content": "trigger.properties.push(\n    createProperty(\n        \"fun\",\n        createIdentifier(name)\n    )\n)"
        },
        "13": {
            "type": "action",
            "one": "8",
            "content": "trigger.properties.push(\n    createProperty(\n        \"rank\",\n        createNumber(proc.rank)\n    )\n)"
        },
        "14": {
            "type": "action",
            "one": "11",
            "content": "proc = context.procs[name]"
        }
    }
}