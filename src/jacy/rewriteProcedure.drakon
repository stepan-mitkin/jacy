{
    "keywords": {
        "function": true
    },
    "params": "context\nprocedure",
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 1,
            "one": "21",
            "content": "Readiness"
        },
        "6": {
            "type": "question",
            "one": "25",
            "two": "23",
            "flag1": 0,
            "content": "procedure.writes.length === 0"
        },
        "18": {
            "type": "question",
            "one": "19",
            "two": "6",
            "flag1": 1,
            "content": "procedure.type === \"trigger\""
        },
        "19": {
            "type": "action",
            "one": "6",
            "content": "addReadiness(procedure, body)"
        },
        "20": {
            "type": "action",
            "one": "18",
            "two": "",
            "content": "body = fun.body.body"
        },
        "21": {
            "type": "action",
            "one": "20",
            "two": "",
            "content": "fun = context.functions[procedure.name]"
        },
        "23": {
            "type": "branch",
            "one": "1",
            "branchId": 5,
            "content": "Exit"
        },
        "24": {
            "type": "branch",
            "one": "28",
            "branchId": 3,
            "content": "Plan triggers"
        },
        "25": {
            "type": "branch",
            "branchId": 2,
            "one": "32",
            "content": "Prepare"
        },
        "26": {
            "type": "branch",
            "branchId": 4,
            "one": "36",
            "content": "Clear variables"
        },
        "27": {
            "type": "action",
            "one": "26",
            "two": "",
            "content": "fun.body = rewriteAst(\n    {},\n    \"\",\n    fun.body,\n    planTriggers,\n    astContext\n)"
        },
        "28": {
            "type": "action",
            "one": "27",
            "two": "",
            "content": "astContext = {\n    plan: {},\n    varReads: context.varReads,\n    variables: context.variables\n}"
        },
        "29": {
            "type": "action",
            "one": "24",
            "two": "",
            "content": "body.push(\n    createCall(\n        createMember(\n            \"runtime\",\n            \"runTriggers\"\n        ),\n        [\"_plan_\", \"_triggers_\"]\n    )\n)"
        },
        "30": {
            "type": "case",
            "one": "34",
            "two": "",
            "content": "\"trigger\""
        },
        "31": {
            "type": "case",
            "one": "33",
            "two": "30",
            "content": "\"method\""
        },
        "32": {
            "type": "select",
            "one": "31",
            "two": "",
            "content": "procedure.type"
        },
        "33": {
            "type": "action",
            "one": "29",
            "two": "",
            "content": "body.unshift(\n    createDeclaration(\n        \"_plan_\",\n        createObjectExpression()\n    )\n)"
        },
        "34": {
            "type": "action",
            "one": "24",
            "two": "",
            "content": "fun.params.push(\n    createIdentifier(\"_plan_\")\n)"
        },
        "36": {
            "type": "question",
            "one": "38",
            "two": "23",
            "flag1": 1,
            "content": "procedure.type === \"method\""
        },
        "38": {
            "type": "action",
            "one": "23",
            "two": "",
            "content": "clearVariables(\n    context,\n    procedure,\n    fun.body.body\n)"
        }
    }
}