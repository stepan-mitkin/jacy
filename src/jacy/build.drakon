{
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 1,
            "one": "11",
            "content": "Find classes"
        },
        "3": {
            "type": "action",
            "one": "4",
            "content": "nsfun = astCopy.body[0]"
        },
        "4": {
            "type": "action",
            "one": "5",
            "content": "nsfun.params.push(\n    createIdentifier(\"runtime\")\n)"
        },
        "5": {
            "type": "action",
            "one": "17",
            "content": "classes = nsfun.body.body.filter(\n    isFunction\n)"
        },
        "11": {
            "type": "action",
            "one": "12",
            "content": "astjs = JSON.stringify(ast)"
        },
        "12": {
            "type": "action",
            "one": "3",
            "content": "astCopy = JSON.parse(astjs)"
        },
        "16": {
            "type": "branch",
            "one": "18",
            "branchId": 3,
            "content": "Exit"
        },
        "17": {
            "type": "branch",
            "one": "21",
            "branchId": 2,
            "content": "Process classes"
        },
        "18": {
            "type": "action",
            "one": "1",
            "content": "return {\n    ast: astCopy,\n    models: models,\n    diagrams: diagrams\n}"
        },
        "19": {
            "type": "loopend",
            "one": "16",
            "two": "",
            "content": ""
        },
        "20": {
            "type": "loopbegin",
            "one": "22",
            "two": "",
            "content": "cls; classes"
        },
        "21": {
            "type": "action",
            "one": "20",
            "two": "",
            "content": "models = []\ndiagrams = []"
        },
        "22": {
            "type": "action",
            "one": "23",
            "two": "",
            "content": "model = processClass(cls, models)"
        },
        "23": {
            "type": "action",
            "one": "24",
            "two": "",
            "content": "diagram = visualize(model)"
        },
        "24": {
            "type": "action",
            "one": "19",
            "two": "",
            "content": "models.push(model)\ndiagrams.push(diagram)"
        }
    },
