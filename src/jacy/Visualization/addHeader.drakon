{
    "keywords": {
        "function": false,
        "machine": false,
        "async": false,
        "export": false,
        "algoprop": false,
        "lazy": false
    },
    "params": "items\ntext",
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 0,
            "one": "3"
        },
        "3": {
            "type": "action",
            "one": "5",
            "content": "headerId = addRectItem(\n    items,\n    \"text\",\n    0,\n    0,\n    calculateItemWidth(text),\n    iconHeight,\n    text\n)"
        },
        "4": {
            "type": "action",
            "one": "1",
            "content": "header.style = JSON.stringify(style)"
        },
        "5": {
            "type": "action",
            "one": "6",
            "content": "style = {font: \"bold 20px Arimo\"}"
        },
        "6": {
            "type": "action",
            "one": "4",
            "content": "header = items[headerId]"
        }
    }
}