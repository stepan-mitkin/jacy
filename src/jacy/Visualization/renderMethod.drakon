{
    "keywords": {
        "function": false,
        "machine": false,
        "async": false,
        "export": false,
        "algoprop": false,
        "lazy": false
    },
    "params": "context\nitems\nmethod",
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 0,
            "one": "4"
        },
        "4": {
            "type": "action",
            "one": "5",
            "content": "functions = getFunctionsForMethod(\n    context,\n    method.name\n)"
        },
        "5": {
            "type": "action",
            "one": "9",
            "content": "leftX = 0"
        },
        "6": {
            "type": "loopend",
            "one": "1",
            "content": ""
        },
        "7": {
            "type": "loopbegin",
            "one": "8",
            "content": "name; functions"
        },
        "8": {
            "type": "action",
            "one": "10",
            "content": "leftX = renderFunction(\n    context,\n    items,\n    name,\n    leftX,\n    topY\n)"
        },
        "9": {
            "type": "action",
            "one": "7",
            "content": "topY = absBottom + verticalSpace"
        },
        "10": {
            "type": "action",
            "one": "6",
            "content": "leftX += horizontalSpace"
        }
    }
}