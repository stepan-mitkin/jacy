{
    "keywords": {
        "function": false,
        "machine": false,
        "async": false,
        "export": false,
        "algoprop": false,
        "lazy": false
    },
    "params": "context\nvariable\noutput",
    "type": "drakon",
    "items": {
        "1": {
            "type": "end"
        },
        "2": {
            "type": "branch",
            "branchId": 0,
            "one": "3"
        },
        "3": {
            "type": "action",
            "one": "4",
            "content": "reads = context.varReads[variable]"
        },
        "4": {
            "type": "question",
            "one": "7",
            "two": "1",
            "flag1": 1,
            "content": "reads"
        },
        "6": {
            "type": "loopend",
            "one": "1",
            "content": ""
        },
        "7": {
            "type": "loopbegin",
            "one": "8",
            "content": "procName; reads"
        },
        "8": {
            "type": "question",
            "one": "9",
            "two": "6",
            "flag1": 0,
            "content": "procName in context.plan"
        },
        "9": {
            "type": "action",
            "one": "10",
            "content": "context.plan[procName] = true"
        },
        "10": {
            "type": "action",
            "one": "11",
            "content": "left = createIndexed(\n    createIdentifier(\"_plan_\"),\n    createString(procName)\n)"
        },
        "11": {
            "type": "action",
            "one": "12",
            "content": "right = createBool(true)"
        },
        "12": {
            "type": "action",
            "one": "13",
            "content": "ass = createAssignment(left, right)"
        },
        "13": {
            "type": "action",
            "one": "6",
            "content": "output.push(ass)"
        }
    }
}